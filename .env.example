# ─────────────────────────────────────────────────────────────
#  Athéna — variables d'environnement
#  Aucune n'est obligatoire pour afficher le site. Chaque parcours
#  de contact reste désactivé (et l'indique) tant que sa variable
#  n'est pas renseignée. Rien n'est simulé.
# ─────────────────────────────────────────────────────────────

# Formulaire de qualification (envoi via l'API Resend).
# Les TROIS variables sont nécessaires pour activer le formulaire.
# L'adresse d'expédition doit appartenir à un domaine vérifié dans Resend.
# RESEND_API_KEY=re_xxxxxxxx
# CONTACT_TO_EMAIL=adresse-de-reception@exemple.fr
# CONTACT_FROM_EMAIL="Athéna <contact@domaine-verifie.fr>"

# Réservation en ligne : URL réelle de l'outil (Calendly, Cal.com…).
# NEXT_PUBLIC_BOOKING_URL=https://calendly.com/…

# Adresse publique du site (URL canoniques, sitemap, Open Graph).
# Sans elle, l'adresse est déduite automatiquement sur Vercel.
# NEXT_PUBLIC_SITE_URL=https://www.exemple.fr
